# Copy to .env and adjust. All patient data in this project is synthetic.

# ---- Database (docker compose builds the connection URLs from these)
POSTGRES_DB=khelp
POSTGRES_USER=khelp
POSTGRES_PASSWORD=change-me
# Password for the restricted khelp_mcp role used by the triage-tools MCP server.
# It can write PENDING proposals and re-check flags, but has no grant to write
# approvals or change a patient's approved priority.
MCP_DB_PASSWORD=change-me-too

# ---- Model. One switch picks self-hosted or hosted.
#   true  -> self-hosted Ollama at OLLAMA_BASE_URL (production shape: data stays on your infrastructure)
#   false -> hosted model from KHELP_HOSTED_PROVIDER (synthetic data only): groq or bedrock
# Use an open-weights model for the scored task (e.g. gpt-oss, Llama, Qwen).
KHELP_USE_LOCAL_MODEL=true
KHELP_HOSTED_PROVIDER=groq

# Self-hosted (Ollama)
#   Same box:   docker compose --profile local-model up -d --build   (OLLAMA_BASE_URL=http://ollama:11434)
#   GPU box:    OLLAMA_BASE_URL=http://<gpu-host>:11434 and run without the profile
OLLAMA_BASE_URL=http://ollama:11434
# 16 GB GPU (e.g. AWS g4dn.xlarge, NVIDIA T4): qwen2.5:14b-instruct reads Pidgin and abbreviated
# notes best. CPU-only test: qwen2.5:3b-instruct works but is slow; qwen2.5:1.5b-instruct does not.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Groq: one key, or several comma-separated in GROQ_API_KEYS (used round-robin, one per run).
# Rate limits apply per Groq organisation, so extra keys only help if they belong to different
# organisations; check that this is within Groq's terms for your use.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
KHELP_REASONING_EFFORT=low

# Amazon Bedrock (credentials from the AWS default chain: the instance role on EC2).
# The model must be enabled for the account in this region.
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_REGION=eu-west-1

# ---- Agent bounds
KHELP_MAX_TOOL_CALLS=12
KHELP_RUN_TIMEOUT_SECONDS=180

# ---- Web
# ":80" serves HTTP on the instance IP. Set a domain (e.g. triage.example.org)
# pointing at the instance and Caddy will obtain an HTTPS certificate.
SITE_ADDRESS=:80

# Synthetic patients seeded into an empty database on first start
KHELP_SEED_COUNT=8

# ---- Running outside Docker (uv run khelp-api / khelp-agent)
# DATABASE_URL=postgresql+psycopg://khelp:change-me@localhost:5432/khelp
# MCP_DATABASE_URL=postgresql+psycopg://khelp_mcp:change-me-too@localhost:5432/khelp
# KHELP_SATS_DIR=/path/to/sats          (defaults to the repo's sats/ folder)
# KHELP_INTAKE_DIR=/path/to/data/intake (defaults to data/intake)
