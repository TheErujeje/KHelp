# Copy to .env and adjust. All patient data in this project is synthetic.

# Open-weights model served by Ollama (must support tool calling)
KHELP_MODEL=qwen2.5:7b-instruct
# Ollama endpoint. Use http://ollama:11434 with `--profile local-model`,
# or point at a separate GPU instance.
OLLAMA_BASE_URL=http://ollama:11434

# App database (owner role, used by the API and migrations)
POSTGRES_DB=khelp
POSTGRES_USER=khelp
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://khelp:change-me@db:5432/khelp

# Restricted role used by the triage-tools MCP server.
# It can write PENDING proposals and re-check flags, but has no grant to
# write approvals or change a patient's approved priority.
MCP_DB_PASSWORD=change-me-too
MCP_DATABASE_URL=postgresql+psycopg://khelp_mcp:change-me-too@db:5432/khelp

# Agent bounds
KHELP_MAX_TOOL_CALLS=12
KHELP_RUN_TIMEOUT_SECONDS=180

# Directory holding sats/*.yaml (defaults to the repo's sats/ folder)
# KHELP_SATS_DIR=/app/sats
