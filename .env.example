# Copy to .env and adjust. All patient data in this project is synthetic.

# ---- Database (docker compose builds the connection URLs from these)
POSTGRES_DB=khelp
POSTGRES_USER=khelp
POSTGRES_PASSWORD=change-me
# Password for the restricted khelp_mcp role used by the triage-tools MCP server.
# It can write PENDING proposals and re-check flags, but has no grant to write
# approvals or change a patient's approved priority.
MCP_DB_PASSWORD=change-me-too

# ---- Model: open-weights only
# Option A: self-hosted Ollama (production shape: data stays on your infrastructure).
#   Same box:    docker compose --profile local-model up -d --build
#   GPU box:     set OLLAMA_BASE_URL=http://<gpu-host>:11434 and run without the profile
KHELP_MODEL_PROVIDER=ollama
KHELP_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://ollama:11434
# On a 16 GB GPU (e.g. AWS g4dn.xlarge, NVIDIA T4) use qwen2.5:14b-instruct: better at
# reading Pidgin and abbreviated notes than the 7B, still fast.
# CPU-only quick test: qwen2.5:3b-instruct works but is slow (minutes per run);
# qwen2.5:1.5b-instruct does not complete the flow.

# Option B: Groq-hosted open-weights model, for development on synthetic data.
# KHELP_MODEL_PROVIDER=groq
# KHELP_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=
# KHELP_REASONING_EFFORT=low

# ---- Agent bounds
KHELP_MAX_TOOL_CALLS=12
KHELP_RUN_TIMEOUT_SECONDS=180

# ---- Web
# ":80" serves HTTP on the instance IP. Set a domain (e.g. triage.example.org)
# pointing at the instance and Caddy will obtain an HTTPS certificate.
SITE_ADDRESS=:80

# Synthetic patients seeded into an empty database on first start
KHELP_SEED_COUNT=8

# ---- Running outside Docker (uv run khelp-api / khelp-agent)
# DATABASE_URL=postgresql+psycopg://khelp:change-me@localhost:5432/khelp
# MCP_DATABASE_URL=postgresql+psycopg://khelp_mcp:change-me-too@localhost:5432/khelp
# KHELP_SATS_DIR=/path/to/sats          (defaults to the repo's sats/ folder)
# KHELP_INTAKE_DIR=/path/to/data/intake (defaults to data/intake)
